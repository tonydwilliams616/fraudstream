        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Calls per minute (total)",
      "description": "All endpoint calls per minute, across every instance - compare with calls per instance to see how the load is spread. (Replaced a CPU panel: SageMaker publishes no instance metrics for this endpoint.)",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "cloudwatch",
