{
  "uid": "fs-endpoint",
  "title": "fraudstream - endpoint and lag",
  "description": "The SageMaker endpoint (scaling, latency, errors, CPU) and Kafka consumer lag, from CloudWatch. Managed by Terraform (25-dashboards) - changes made in the UI are overwritten on the next apply.",
  "tags": [
    "fraudstream",
    "terraform"
  ],
  "timezone": "utc",
  "refresh": "1m",
  "schemaVersion": 39,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "editable": true,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Calls per instance (scaling metric)",
      "description": "SageMakerVariantInvocationsPerInstance - what target tracking watches. Above the dashed line (100/min) it adds instances; below 90 for ~15 min it removes one.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "cloudwatch",
        "uid": "fs-cloudwatch"
      },
      "targets": [
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "fs-cloudwatch"
          },
          "refId": "A",
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "default",
          "namespace": "AWS/SageMaker",
          "metricName": "InvocationsPerInstance",
          "dimensions": {
            "EndpointName": "fs-fraud",
            "VariantName": "AllTraffic"
          },
          "statistic": "Sum",
          "period": "60",
          "matchExact": true,
          "id": "",
          "expression": "",
          "label": "calls per instance per minute"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Instances serving",
      "description": "Worked out as total calls / calls per instance (SageMaker doesn't publish an instance count). Min 2, max 4.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "cloudwatch",
        "uid": "fs-cloudwatch"
      },
      "targets": [
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "fs-cloudwatch"
          },
          "refId": "A",
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "default",
          "namespace": "AWS/SageMaker",
          "metricName": "Invocations",
          "dimensions": {
            "EndpointName": "fs-fraud",
            "VariantName": "AllTraffic"
          },
          "statistic": "Sum",
          "period": "60",
          "matchExact": true,
          "id": "",
          "expression": "",
          "label": "",
          "hide": true
        },
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "fs-cloudwatch"
          },
          "refId": "B",
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "default",
          "namespace": "AWS/SageMaker",
          "metricName": "InvocationsPerInstance",
          "dimensions": {
            "EndpointName": "fs-fraud",
            "VariantName": "AllTraffic"
          },
          "statistic": "Sum",
          "period": "60",
          "matchExact": true,
          "id": "",
          "expression": "",
          "label": "",
          "hide": true
        },
        {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "refId": "C",
          "type": "math",
          "expression": "$A / $B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Model latency",
