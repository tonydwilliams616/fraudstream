          "label": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "\u00b5s"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Endpoint errors",
      "description": "4xx (e.g. a model that rejects its input - what rolled back the broken v4) and 5xx per minute. The canary alarms watch these.",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "cloudwatch",
        "uid": "fs-cloudwatch"
      },
      "targets": [
        {
          "datasource": {
            "type": "cloudwatch",
