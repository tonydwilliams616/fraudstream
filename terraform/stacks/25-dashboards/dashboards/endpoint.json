    {
      "id": 6,
      "type": "timeseries",
      "title": "Consumer lag (MSK, unread messages)",
      "description": "Transactions waiting unread in Kafka for the consumer group, all partitions (SumOffsetLag). Healthy is a few hundred (the consumer commits once a minute). The fs-consumer-lag alarm emails at over 3,000 (~5 minutes of traffic) for 10 minutes.",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "cloudwatch",
        "uid": "fs-cloudwatch"
      },
      "targets": [
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "fs-cloudwatch"
          },
          "refId": "A",
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "default",
          "namespace": "AWS/Kafka",
          "metricName": "SumOffsetLag",
          "dimensions": {
            "Cluster Name": "fs-msk",
            "Consumer Group": "fs-scorer",
            "Topic": "transactions"
          },
          "statistic": "Maximum",
          "period": "300",
          "matchExact": true,
          "id": "",
          "expression": "",
          "label": "unread messages"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 3000
              }
            ]
          }
        },
        "overrides": []
      }
