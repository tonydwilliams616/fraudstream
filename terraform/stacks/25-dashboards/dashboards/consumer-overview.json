{
  "uid": "fs-consumer",
  "title": "fraudstream - consumer overview",
  "description": "The streaming scorer: throughput, latency, endpoint health, alert rate and score distribution. Managed by Terraform (25-dashboards) - changes made in the UI are overwritten on the next apply.",
  "tags": [
    "fraudstream",
    "terraform"
  ],
  "timezone": "utc",
  "refresh": "30s",
  "schemaVersion": 39,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "editable": true,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Scored per second",
      "description": "Transactions scored per second, all consumer tasks (5-minute rate).",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fs-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "fs-prometheus"
          },
          "expr": "sum(rate(fraudstream_transactions_scored_total[5m]))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Alert rate",
      "description": "Share of scored transactions that raised a fraud alert (15-minute window). Budget ~0.5%.",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fs-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "fs-prometheus"
          },
          "expr": "sum(rate(fraudstream_alerts_total[15m])) / sum(rate(fraudstream_transactions_scored_total[15m]))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.0075
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Live model",
      "description": "The model version the consumer is scoring with (from fraudstream_model_info).",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fs-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "fs-prometheus"
          },
          "expr": "max by (model_version) (fraudstream_model_info)",
          "legendFormat": "v{{model_version}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "name"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Since last checkpoint",
      "description": "Seconds since offsets were last committed. Normally under ~60 s; climbing means scoring is stuck.",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fs-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "fs-prometheus"
          },
          "expr": "time() - max(fraudstream_last_checkpoint_timestamp_seconds)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 120
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Throughput",
      "description": "Messages read, transactions scored and unreadable messages, per second.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fs-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "fs-prometheus"
          },
          "expr": "sum(rate(fraudstream_transactions_consumed_total[5m]))",
          "legendFormat": "consumed",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "fs-prometheus"
          },
          "expr": "sum(rate(fraudstream_transactions_scored_total[5m]))",
          "legendFormat": "scored",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "fs-prometheus"
          },
          "expr": "sum(rate(fraudstream_bad_messages_total[5m]))",
          "legendFormat": "unreadable",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "End-to-end latency",
      "description": "From the simulator producing a transaction to its score being ready (p50 and p99, 5-minute window).",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fs-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "fs-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(fraudstream_end_to_end_latency_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "fs-prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(fraudstream_end_to_end_latency_seconds_bucket[5m])))",
          "legendFormat": "p99",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Endpoint call duration",
      "description": "One SageMaker call, every attempt including failures (p50 and p99).",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fs-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "fs-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(fraudstream_endpoint_call_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "fs-prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(fraudstream_endpoint_call_seconds_bucket[5m])))",
          "legendFormat": "p99",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Endpoint errors",
      "description": "Failed SageMaker calls per second. Retries hide these from scoring, not from here.",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fs-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "fs-prometheus"
          },
          "expr": "sum(rate(fraudstream_endpoint_errors_total[5m]))",
          "legendFormat": "errors/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Transactions per endpoint call",
      "description": "Average batch size per SageMaker call (max 50). Low values mean many small calls.",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fs-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "fs-prometheus"
          },
          "expr": "sum(rate(fraudstream_batch_size_sum[5m])) / sum(rate(fraudstream_batch_size_count[5m]))",
          "legendFormat": "avg per call",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Alerts by model",
      "description": "Fraud alerts per minute, by the model version that raised them.",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fs-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "fs-prometheus"
          },
          "expr": "sum by (model_version) (rate(fraudstream_alerts_total[5m])) * 60",
          "legendFormat": "v{{model_version}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "bargauge",
      "title": "Score distribution (last hour)",
      "description": "How many transactions fell in each score band over the last hour. A shift here, with no model change, suggests drift.",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fs-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "fs-prometheus"
          },
          "expr": "sum by (le) (increase(fraudstream_score_bucket[1h]))",
          "legendFormat": "{{le}}",
          "refId": "A",
          "format": "heatmap",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "vertical",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    }
  ]
}
